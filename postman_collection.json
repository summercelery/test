    {
      "name": "获取微信授权URL",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/auth/wechat/auth-url?redirectUri=http://localhost/wechat-callback.html&state=test_state",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "auth", "wechat", "auth-url"],
          "query": [
            {
              "key": "redirectUri",
              "value": "http://localhost/wechat-callback.html"
            },
            {
              "key": "state",
              "value": "test_state"
            }
          ]
        }
      }
    },
    {
      "name": "微信登录",
      "request": {
        "method": "POST",
        "header": [
